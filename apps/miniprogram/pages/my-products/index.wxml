<view class="page">
  <view class="search-row"><input placeholder="按商品标题查询" value="{{q}}" bindinput="onInput" confirm-type="search" bindconfirm="load"/><button class="primary" size="mini" bindtap="load">查询</button></view>
  <view class="product-metrics"><view class="metric {{activeMetric==='ALL' ? 'active' : ''}}" data-metric="ALL" bindtap="chooseMetric"><text class="metric-value">{{totalCount}}</text><text class="metric-label">全部商品</text></view><view class="metric {{activeMetric==='PUBLISHED' ? 'active' : ''}}" data-metric="PUBLISHED" bindtap="chooseMetric"><text class="metric-value">{{publishedCount}}</text><text class="metric-label">当前上架</text></view><view class="metric {{activeMetric==='OFF_SHELF' ? 'active' : ''}}" data-metric="OFF_SHELF" bindtap="chooseMetric"><text class="metric-value">{{offShelfCount}}</text><text class="metric-label">下架商品</text></view><view class="metric {{activeMetric==='DELETED' ? 'active' : ''}}" data-metric="DELETED" bindtap="chooseMetric"><text class="metric-value">{{recentlyDeletedCount}}</text><text class="metric-label">最近删除</text></view></view>
  <view wx:if="{{loading}}" class="loading">正在查询商品…</view>
  <view wx:for="{{items}}" wx:key="id" class="card product-card">
    <image src="{{item.cover_url}}" mode="aspectFill"/>
    <view class="product-main">
      <view class="product-heading"><view class="product-title">{{item.description}}</view><text class="status {{item.status==='PUBLISHED' && !item.deleted_at ? 'published' : 'off-shelf'}}">{{item.deleted_at ? '已删除' : item.status==='PUBLISHED' ? '已上架' : item.status==='SOLD' ? '已售出' : '已下架'}}</text></view>
      <view class="product-price">{{item.price_type==='NEGOTIABLE' ? '面议' : 'R$ '+item.price+(item.price_unit ? ' / '+item.price_unit : '')}}</view>
      <view class="product-meta">规格：{{item.spec_text || '暂未填写'}}</view>
      <view class="product-meta">装箱数：{{item.extra_attrs.piecesPerBox || '-' }} pcs/cx · 最低起订：{{item.extra_attrs.minCartons || 1}} 箱</view>
      <view class="actions" wx:if="{{!item.deleted_at}}"><button size="mini" data-id="{{item.id}}" bindtap="edit">编辑</button><button size="mini" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="toggleStatus">{{item.status==='PUBLISHED' ? '下架' : '上架'}}</button><button size="mini" class="danger" data-id="{{item.id}}" bindtap="remove">删除</button></view>
      <view class="actions" wx:else><button size="mini" class="primary" data-id="{{item.id}}" bindtap="restore">恢复上架</button><text class="deleted-tip">保留至删除后第 15 天</text></view>
    </view>
  </view>
  <view wx:if="{{!loading && !items.length}}" class="empty">暂无符合条件的商品。</view>
  <view wx:if="{{drawerVisible}}" class="drawer-mask" bindtap="closeEdit">
    <view class="edit-drawer {{drawerOpen ? 'open' : ''}}" catchtap="noop">
      <view class="drawer-head"><text>编辑商品</text><text class="drawer-close" bindtap="closeEdit">×</text></view>
      <scroll-view scroll-y class="drawer-body">
        <view class="field-label">商品图片 <text>至少 1 张</text></view>
        <view class="edit-photos"><view wx:for="{{editImages}}" wx:key="url" class="edit-photo"><image src="{{item.url}}" mode="aspectFill"/><text class="remove-image" data-index="{{index}}" bindtap="removeEditImage">×</text></view><view wx:if="{{editImages.length<9}}" class="add-image" bindtap="addEditImages">＋</view></view>
        <view class="field-label">商品标题</view><input value="{{editTitle}}" maxlength="100" placeholder="请输入商品标题" bindinput="setEditTitle"/>
        <view class="field-label">商品分类</view><picker mode="selector" range="{{categoryOptions}}" range-key="path" value="{{editCategoryIndex}}" bindchange="changeEditCategory"><view class="category-select">{{categoryOptions[editCategoryIndex].path || '请选择三级商品分类'}}<text>›</text></view></picker>
        <view class="field-label">商品单价（R$/pc）</view><input value="{{editPrice}}" type="digit" placeholder="例如：8.50" bindinput="setEditPrice"/>
        <view class="field-label">规格与型号</view><input value="{{editSpec}}" placeholder="型号、尺寸、重量或包装方式" bindinput="setEditSpec"/>
        <view class="field-label">装箱与起订</view><view class="quantity-grid"><view><text>装箱数（pcs/cx）</text><input value="{{editPiecesPerBox}}" type="number" placeholder="例如：24" bindinput="setEditPiecesPerBox"/></view><view><text>最低起订（箱）</text><input value="{{editMinCartons}}" type="number" placeholder="例如：1" bindinput="setEditMinCartons"/></view></view>
      </scroll-view>
      <view class="drawer-actions"><button bindtap="closeEdit">取消</button><button class="primary" loading="{{saving}}" bindtap="save">保存修改</button></view>
    </view>
  </view>
</view>
