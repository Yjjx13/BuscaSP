.favorite-card{display:flex;gap:18rpx;margin-bottom:18rpx;padding:18rpx}.favorite-card image{width:170rpx;height:170rpx;flex:0 0 170rpx;border-radius:12rpx;background:#eef2f4}.favorite-card>view{min-width:0;flex:1}.title{font-size:29rpx;font-weight:600;line-height:1.45;word-break:break-all}.price{margin:12rpx 0;color:#c24156;font-size:31rpx;font-weight:600}.empty{text-align:center;color:#98a2b3;padding:90rpx 20rpx}
