<view class="page"><view wx:if="{{loading}}" class="empty">正在加载收藏商品…</view><view wx:for="{{items}}" wx:key="id" class="card favorite-card" bindtap="detail" data-id="{{item.id}}"><image src="{{item.cover_url}}" mode="aspectFill"/><view><view class="title">{{item.description}}</view><view class="price">{{item.price_type==='NEGOTIABLE' ? '面议' : 'R$ '+item.price+(item.price_unit ? ' / '+item.price_unit : '')}}</view><view class="muted">商家：{{item.nickname}}</view></view></view><view wx:if="{{!loading && !items.length}}" class="empty">暂未收藏货源。</view></view>
