<view class="page">
  <view class="card user"><view class="avatar">货</view><view><view class="name">{{user.nickname||'找货用户'}}</view><view class="muted">统一发布与找货身份</view></view></view>
  <view class="counts"><view bindtap="goWantedHistory"><strong>{{wanted.length}}</strong><text>找货历史</text></view><view bindtap="goFavorites"><strong>{{favorites.length}}</strong><text>我的收藏</text></view></view>
  <view class="card setting" bindtap="goRegionSettings"><view><view class="title">所在地区</view><view class="muted">{{user.region_name || '请选择商家所在的圣保罗地区'}}</view></view><text>›</text></view>
  <view class="card setting" bindtap="goContacts"><view><view class="title">联系方式设置</view><view class="muted">设置后，其他用户可在商品详情中联系你</view></view><text>›</text></view>
  <view class="card setting" bindtap="goMyProducts"><view><view class="title">管理我的商品</view><view class="muted">查询、编辑、上下架或删除已发布商品</view></view><text>›</text></view>
  <view class="card setting" bindtap="goWantedHistory"><view><view class="title">找货历史</view><view class="muted">查看找货需求的状态及收到的回应</view></view><text>›</text></view>
  <view class="card setting" bindtap="goFavorites"><view><view class="title">我的收藏</view><view class="muted">查看已收藏的货源</view></view><text>›</text></view>
</view>
