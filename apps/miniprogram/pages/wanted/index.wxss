.wanted-search{display:flex;gap:14rpx;margin-bottom:18rpx}.wanted-search input{min-width:0;flex:1;margin:0;padding:18rpx 20rpx;border-radius:12rpx;background:#fff;border:2rpx solid #e5eaed}.wanted-search button{width:130rpx;margin:0}.create-button{width:100%;margin:0 0 22rpx}.wanted-card{display:flex;gap:18rpx}.wanted-card>image{width:150rpx;height:150rpx;flex:0 0 150rpx;border-radius:12rpx;background:#eef3f5}.wanted-content{min-width:0;flex:1}.wanted-card button{min-height:64rpx;margin:16rpx 0 0;padding:0 24rpx;font-size:25rpx}.wanted-title{font-size:30rpx;line-height:1.5;margin-bottom:8rpx;word-break:break-all}.wanted-meta{color:#667085;font-size:23rpx;line-height:1.55}.empty{text-align:center;color:#98a2b3;padding:80rpx 20rpx}
.drawer-mask{position:fixed;z-index:9999;inset:0;background:rgba(16,24,40,.45);display:flex;justify-content:flex-end}.response-drawer{width:88%;max-width:680rpx;height:100%;padding:40rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));background:#fff;overflow-y:auto;animation:drawerIn .22s ease-out}.drawer-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28rpx}.drawer-title{font-size:36rpx;font-weight:700}.drawer-subtitle{margin-top:6rpx;color:#667085;font-size:24rpx}.drawer-head>text{padding:0 10rpx;font-size:48rpx;color:#667085}.demand-summary{padding:22rpx;margin-bottom:28rpx;border-radius:14rpx;background:#eef7f9;line-height:1.5}.field-label{margin:24rpx 0 12rpx;font-weight:600}.field-label text{margin-left:8rpx;color:#d92d20;font-size:22rpx}.field-label .optional{color:#98a2b3}.response-drawer input,.response-drawer textarea,.picker-field{padding:20rpx;border-radius:14rpx;background:#f5f8fa;border:2rpx solid #e5eaed}.picker-field{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;color:#344054}.picker-field>text{color:#98a2b3}.selected-product{display:flex;gap:16rpx;margin-top:14rpx;padding:16rpx;border-radius:14rpx;background:#eef7f9}.selected-product image{width:96rpx;height:96rpx;flex:none;border-radius:10rpx}.selected-product>view{min-width:0}.selected-product>view>view{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-height:1.4}.selected-product text{display:block;margin-top:6rpx;color:#667085;font-size:22rpx}.stock-options{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.stock-options view{padding:22rpx;border:2rpx solid #e5eaed;border-radius:14rpx;text-align:center;background:#f5f8fa}.stock-options .selected.spot{border-color:#12b76a;background:#ecfdf3;color:#067647;font-weight:700}.stock-options .selected.presale{border-color:#f79009;background:#fffaeb;color:#b54708;font-weight:700}.response-drawer textarea{min-height:190rpx}.submit-response{width:100%;margin-top:36rpx}.response-drawer button[disabled]{opacity:.65}@keyframes drawerIn{from{transform:translateX(100%)}to{transform:translateX(0)}}
