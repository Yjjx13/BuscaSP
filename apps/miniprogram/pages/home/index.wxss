.home-search-fixed{position:fixed;z-index:1000;top:0;left:0;right:0;padding:16rpx 24rpx 14rpx;background:rgba(245,248,250,.97);box-shadow:0 5rpx 16rpx rgba(23,50,77,.08)}.search{min-height:84rpx;display:flex;align-items:center;background:#fff;border-radius:42rpx;padding:18rpx 28rpx;color:#667085;box-sizing:border-box}.home-content{padding-top:114rpx}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin:22rpx 0}.action{min-width:0;background:#dff3f1;border-radius:16rpx;padding:24rpx 8rpx;text-align:center;color:#176b87;font-size:36rpx}.action text{display:block;font-size:24rpx;line-height:1.35;margin-top:8rpx}.category-tabs{display:flex;white-space:nowrap;margin:2rpx -24rpx 0;padding:16rpx 24rpx;background:#fff;border-top:1rpx solid #eef2f4;border-bottom:1rpx solid #eef2f4}.category-tab{display:inline-flex;align-items:center;justify-content:center;margin-right:40rpx;padding:4rpx 0 12rpx;color:#475467;font-size:28rpx;line-height:1.4}.category-tab.active{color:#176b87;font-weight:600;border-bottom:5rpx solid #176b87}.section-title{font-size:34rpx;font-weight:600;margin:28rpx 0 16rpx}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;align-items:start}.product{min-width:0;overflow:hidden;background:#fff;border-radius:18rpx;box-shadow:0 4rpx 16rpx rgba(23,50,77,.06)}.product image{display:block;width:100%;min-height:240rpx;background:#eef2f4}.product-body{padding:18rpx}.desc{font-size:28rpx;line-height:1.45;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-all}.spec{margin-top:10rpx;color:#667085;font-size:23rpx;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.price{color:#c24156;font-size:32rpx;font-weight:600;margin:12rpx 0 6rpx}.seller{color:#98a2b3;font-size:22rpx}.empty{text-align:center;color:#98a2b3;padding:80rpx 20rpx}@media (max-width:350px){.actions{gap:10rpx}.product-grid{gap:12rpx}.product-body{padding:14rpx}.category-tab{margin-right:28rpx;font-size:26rpx}}
