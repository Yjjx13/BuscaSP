<view class="page"><button class="primary" bindtap="create">发布我要找的货</button><view wx:for="{{items}}" wx:key="id" class="card"><view class="desc">{{item.description||'用户发布了图片找货需求'}}</view><view class="muted">发布者：{{item.nickname}}</view><view class="muted">有效至：{{item.expires_at}}</view><button size="mini" bindtap="respond" data-id="{{item.id}}">我有这个货</button></view><view wx:if="{{!items.length}}" class="empty">暂时没有找货需求</view></view>
