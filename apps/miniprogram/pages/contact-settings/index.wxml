<view class="page"><view class="card"><view class="notice">联系方式会加密保存。其他用户只能在点击“联系发布者”后查看，不会出现在商品列表中。</view><view class="tabs"><view class="{{contactType==='PHONE'?'selected':''}}" data-type="PHONE" bindtap="selectType">手机号</view><view class="{{contactType==='WECHAT'?'selected':''}}" data-type="WECHAT" bindtap="selectType">微信号</view></view><input placeholder="{{contactType==='PHONE'?'请输入手机号':'请输入微信号'}}" value="{{value}}" bindinput="setValue"/><button class="primary" loading="{{saving}}" bindtap="save">保存联系方式</button></view><view class="card"><view class="title">已设置联系方式</view><view wx:for="{{contacts}}" wx:key="id" class="contact"><text>{{item.contact_type==='PHONE'?'手机号':'微信号'}}</text><text>{{item.masked_value}}</text></view><view wx:if="{{!contacts.length}}" class="muted">尚未设置联系方式</view></view></view>
