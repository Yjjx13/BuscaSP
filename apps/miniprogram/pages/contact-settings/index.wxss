.notice{color:#667085;font-size:25rpx;line-height:1.65}.tabs{display:flex;margin:26rpx 0;border-radius:12rpx;overflow:hidden}.tabs view{flex:1;min-height:82rpx;display:flex;align-items:center;justify-content:center;background:#f3f6f8}.tabs .selected{background:#dff3f1;color:#176b87;font-weight:600}input{display:block;background:#f6f8fa;border:2rpx solid transparent;border-radius:12rpx;padding:20rpx 22rpx;margin-bottom:20rpx}input:focus{border-color:#4f96aa;background:#fff}.primary{width:100%}.title{font-weight:600;margin-bottom:15rpx}.contact{display:flex;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-top:1rpx solid #edf1f3}.contact text:last-child{word-break:break-all;text-align:right}
