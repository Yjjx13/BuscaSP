<view class="page"><view class="card"><view class="label">商品图片 <text>必填</text></view><view class="photos"><view wx:for="{{images}}" wx:key="*this" class="photo"><image src="{{item}}" mode="aspectFill"/></view><view wx:if="{{images.length<9}}" class="add" bindtap="chooseImage">＋</view></view><view class="label">商品标题 <text>必填</text></view><textarea placeholder="示例：304不锈钢保温杯 500ml" maxlength="100" data-key="description" bindinput="set"/><view class="label">商品分类 <text>必填</text></view><picker mode="multiSelector" range="{{range}}" range-key="name" value="{{indexes}}" bindcolumnchange="changeColumn" bindchange="chooseCategory"><view class="category-picker">{{categoryPath || '请选择一级、二级及三级商品分类'}}<text>›</text></view></picker><view class="label">报价与起订信息 <text>必填</text></view><view class="price-grid"><view><text>商品单价（R$/pc）</text><input type="digit" data-key="unitPrice" bindinput="set"/></view><view><text>每箱装箱数量</text><input type="number" data-key="piecesPerBox" bindinput="set"/></view><view><text>最低起订箱数</text><input type="number" value="{{minCartons}}" data-key="minCartons" bindinput="set"/></view></view><view class="label">规格与型号</view><input placeholder="型号、尺寸、重量或包装方式" data-key="specText" bindinput="set"/><button class="primary submit" loading="{{submitting}}" bindtap="submit">确认发布</button></view></view>
