.page{padding:0 0 calc(128rpx + env(safe-area-inset-bottom))}.skeleton-image,.gallery-wrap{width:100%;height:min(100vw,720px);max-height:750rpx;background:#edf1f3}.skeleton-image{animation:pulse 1.2s ease-in-out infinite}.skeleton-card{margin:20rpx 24rpx;padding:28rpx;background:#fff;border-radius:18rpx}.skeleton-card view{height:28rpx;margin:18rpx 0;border-radius:10rpx;background:#e8edef;animation:pulse 1.2s ease-in-out infinite}.skeleton-card view:first-child{width:38%;height:44rpx}.skeleton-card view:nth-child(3){width:82%}.skeleton-card view:last-child{width:65%}.load-error{padding:180rpx 40rpx;text-align:center}.error-title{font-size:32rpx;font-weight:600}.error-text{margin:18rpx 0 30rpx;color:#667085;font-size:26rpx}.retry-button{width:260rpx}.gallery-wrap{position:relative}.gallery,.gallery image{width:100%;height:100%}.gallery-placeholder{height:100%;display:flex;align-items:center;justify-content:center;color:#98a2b3;font-size:26rpx;animation:pulse 1.2s ease-in-out infinite}.image-count{position:absolute;right:22rpx;bottom:20rpx;padding:8rpx 16rpx;border-radius:24rpx;background:rgba(0,0,0,.55);color:#fff;font-size:22rpx}.page>.card{width:auto;margin:20rpx 24rpx}.product-info{padding:28rpx}.quote-label{font-size:24rpx;color:#667085}.price{font-size:44rpx;color:#c24156;font-weight:600;word-break:break-all;margin-top:4rpx}.desc{font-size:31rpx;line-height:1.65;margin-top:20rpx;word-break:break-word}.card-title{padding-bottom:16rpx;font-size:30rpx;font-weight:600}.info-row{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx;padding:20rpx 0;border-top:1rpx solid #edf1f3;font-size:27rpx;line-height:1.5}.info-row text:first-child{flex:0 0 168rpx;color:#667085}.info-row text:last-child{flex:1;text-align:right;word-break:break-all}.contact-result{border:2rpx solid #d8e9ed}.contact-title{font-weight:600;font-size:29rpx}.contact-value{margin:16rpx 0;font-size:32rpx;color:#176b87;font-weight:600;word-break:break-all}.copy-button{width:100%;min-height:76rpx;background:#eff7f8;color:#176b87;font-size:27rpx}.contact-hint{margin-top:16rpx;color:#667085;font-size:23rpx;line-height:1.55}.bottom{position:fixed;z-index:10;bottom:0;left:0;right:0;background:#fff;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));display:flex;gap:16rpx;box-shadow:0 -4rpx 18rpx rgba(23,50,77,.08)}.bottom button{min-width:0;flex:1;margin:0}@keyframes pulse{0%,100%{opacity:.55}50%{opacity:1}}@media (min-width:768px){.bottom{padding-left:calc((100% - 720px)/2 + 24rpx);padding-right:calc((100% - 720px)/2 + 24rpx)}}
