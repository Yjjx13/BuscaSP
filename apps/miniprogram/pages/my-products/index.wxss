.search-row{display:flex;gap:14rpx;margin-bottom:20rpx}.search-row input{min-width:0;flex:1;margin:0;background:#fff;border:2rpx solid #e5eaed;border-radius:12rpx;padding:18rpx 20rpx;font-size:27rpx}.search-row button{width:130rpx;margin:0}.product-metrics{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-bottom:20rpx}.metric{display:flex;align-items:baseline;gap:12rpx;padding:20rpx 22rpx;border:2rpx solid transparent;border-radius:14rpx;background:#fff}.metric.active{border-color:#3f8ca5;background:#f0fafc}.metric-value{color:#1f5570;font-size:40rpx;font-weight:700}.metric-label{color:#667085;font-size:24rpx}.loading,.empty{text-align:center;padding:70rpx 20rpx;color:#98a2b3}.product-card{display:flex;gap:18rpx;margin-bottom:18rpx;padding:18rpx}.product-card image{width:180rpx;height:180rpx;flex:0 0 180rpx;border-radius:12rpx;background:#eef2f4}.product-main{min-width:0;flex:1}.product-heading{display:flex;align-items:flex-start;gap:12rpx}.product-title{min-width:0;flex:1;font-size:29rpx;line-height:1.45;word-break:break-all}.status{flex:0 0 auto;padding:5rpx 10rpx;border-radius:8rpx;font-size:21rpx;line-height:1.3}.status.published{color:#16803c;background:#eaf8ef}.status.off-shelf{color:#c24156;background:#fff0f2}.product-price{margin:10rpx 0;color:#c24156;font-size:31rpx;font-weight:600}.product-meta{color:#667085;font-size:23rpx;line-height:1.6}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.actions button{margin:0;line-height:1.8;font-size:23rpx}.actions .danger{color:#c24156;border-color:#f0c8d0}.deleted-tip{color:#98a2b3;font-size:21rpx}.drawer-mask{position:fixed;z-index:20;inset:0;background:rgba(0,0,0,.4)}.edit-drawer{position:absolute;top:0;right:0;width:88%;max-width:680rpx;height:100%;display:flex;flex-direction:column;background:#f6f8fa;transform:translateX(100%);transition:transform .25s ease}.edit-drawer.open{transform:translateX(0)}.drawer-head{display:flex;align-items:center;justify-content:space-between;padding:28rpx 30rpx;background:#fff;font-size:33rpx;font-weight:600}.drawer-close{padding:0 8rpx;color:#667085;font-size:52rpx;font-weight:300;line-height:1}.drawer-body{min-height:0;flex:1;padding:28rpx 30rpx;box-sizing:border-box}.field-label{margin:20rpx 0 12rpx;font-size:26rpx;font-weight:600;color:#344054}.field-label:first-child{margin-top:0}.field-label text{margin-left:8rpx;color:#98a2b3;font-size:22rpx;font-weight:400}.drawer-body input{box-sizing:border-box;width:100%;padding:18rpx 20rpx;border:2rpx solid #e2e8ee;border-radius:12rpx;background:#fff;font-size:26rpx}.edit-photos{display:flex;flex-wrap:wrap;gap:14rpx}.edit-photo,.add-image{position:relative;width:130rpx;height:130rpx;border-radius:12rpx;overflow:hidden}.edit-photo image{display:block;width:100%;height:100%}.remove-image{position:absolute;top:0;right:0;width:38rpx;height:38rpx;border-radius:0 0 0 12rpx;background:rgba(0,0,0,.6);color:#fff;text-align:center;line-height:36rpx;font-size:29rpx}.add-image{display:flex;align-items:center;justify-content:center;border:2rpx dashed #b8c7d1;background:#fff;color:#78909c;font-size:52rpx}.category-select{display:flex;align-items:center;justify-content:space-between;padding:18rpx 20rpx;border:2rpx solid #e2e8ee;border-radius:12rpx;background:#fff;font-size:26rpx;color:#344054}.category-select text{color:#98a2b3;font-size:38rpx;line-height:1}.quantity-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.quantity-grid text{display:block;margin-bottom:10rpx;color:#667085;font-size:22rpx}.drawer-actions{display:flex;gap:16rpx;padding:20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e9eef1}.drawer-actions button{flex:1;margin:0;font-size:27rpx}.drawer-actions button:first-child{background:#f2f4f6;color:#475467}@media(max-width:350px){.product-card{gap:12rpx}.product-card image{width:145rpx;height:145rpx;flex-basis:145rpx}.status{padding:4rpx 8rpx}.edit-drawer{width:94%}.drawer-body{padding:24rpx}.drawer-head{