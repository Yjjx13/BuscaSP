<view class="page"><view wx:if="{{loading}}" class="empty">正在加载找货历史…</view><view wx:for="{{items}}" wx:key="id" class="card history-card"><view class="title">{{item.description || '图片找货需求'}}</view><view class="row"><text>当前状态</text><text>{{item.status==='ACTIVE' ? '寻找中' : item.status==='FOUND' ? '已找到' : item.status==='EXPIRED' ? '已过期' : '已下架'}}</text></view><view class="row"><text>收到回应</text><text>{{item.response_count || 0}} 条</text></view><view class="row"><text>创建时间</text><text>{{item.created_at}}</text></view></view><view wx:if="{{!loading && !items.length}}" class="empty">暂未发布找货需求。</view></view>
