.label{font-weight:600;margin:28rpx 0 14rpx;line-height:1.4}.label:first-child{margin-top:0}.label text{color:#c24156;font-size:23rpx}.category-picker{min-height:84rpx;display:flex;align-items:center;justify-content:space-between;padding:18rpx 22rpx;border:2rpx solid #e5eaed;border-radius:12rpx;background:#f6f8fa;color:#98a2b3;font-size:26rpx;line-height:1.4;box-sizing:border-box}.category-picker.selected{color:#344054;background:#fff;border-color:#8bb7c3}.category-picker text{flex:none;margin-left:16rpx;color:#667085;font-size:38rpx}.description-tip{padding:16rpx 18rpx;margin:-2rpx 0 14rpx;border-radius:10rpx;background:#eef7f8;color:#46717b;font-size:24rpx;line-height:1.55}.title-input{height:120rpx;min-height:120rpx}.validation-error{margin:-8rpx 0 16rpx;color:#c24156;font-size:24rpx}.price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}.input-label{min-height:58rpx;color:#667085;font-size:22rpx;line-height:1.35}.price-grid input{width:auto;min-width:0;margin-bottom:0}.photos{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.photo,.add{width:100%;aspect-ratio:1;border-radius:12rpx;overflow:hidden;background:#edf3f5}.photo image{width:100%;height:100%}.add{display:flex;align-items:center;justify-content:center;color:#176b87;font-size:55rpx;border:2rpx dashed #b8d4dc}textarea,input{display:block;background:#f6f8fa;border:2rpx solid transparent;border-radius:12rpx;padding:20rpx 22rpx;margin-bottom:18rpx;box-sizing:border-box}textarea:focus,input:focus{border-color:#4f96aa;background:#fff}.submit{width:100%;margin-top:34rpx;margin-bottom:calc(8rpx + env(safe-area-inset-bottom))}@media (max-width:350px){.photos{grid-template-columns:repeat(3,1fr)}.price-grid{grid-template-columns:1fr}.input-label{min-height:auto}}
