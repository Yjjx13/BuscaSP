.user{display:flex;align-items:center;gap:20rpx}.user>view:last-child{min-width:0;flex:1}.avatar{width:90rpx;height:90rpx;flex:0 0 90rpx;border-radius:50%;background:#176b87;color:#fff;display:flex;align-items:center;justify-content:center}.name{font-size:34rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.counts{display:flex;background:#fff;border-radius:20rpx;margin:20rpx 0;padding:22rpx 0;overflow:hidden}.counts view{min-width:0;flex:1;text-align:center;border-right:1rpx solid #edf1f3}.counts view:last-child{border:0}.counts strong{display:block;font-size:34rpx}.counts text{display:block;color:#667085;font-size:23rpx;line-height:1.35;padding:0 6rpx}.title{font-weight:600;margin-bottom:15rpx}.row{padding:20rpx 0;border-top:1rpx solid #edf1f3;font-size:28rpx;line-height:1.5;word-break:break-all}.setting{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.setting>view{min-width:0;flex:1}.setting>text{font-size:42rpx;color:#98a2b3}
