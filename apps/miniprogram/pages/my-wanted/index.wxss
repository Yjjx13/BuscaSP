.history-card{margin-bottom:18rpx}.card-main{display:flex;gap:18rpx}.card-main image{width:130rpx;height:130rpx;flex:none;border-radius:12rpx;background:#eef3f5}.card-content{min-width:0;flex:1}.title{font-size:30rpx;font-weight:600;line-height:1.5;word-break:break-all}.status-text{display:inline-flex;margin-top:10rpx;padding:6rpx 14rpx;border-radius:999rpx;background:#ecfdf3;color:#067647;font-size:22rpx}.row{display:flex;justify-content:space-between;gap:20rpx;padding-top:18rpx;margin-top:18rpx;border-top:1rpx solid #edf1f3;color:#667085;font-size:25rpx}.row text:last-child{text-align:right;color:#344054;word-break:break-all}.response-count{color:#176b87!important;font-weight:600}.unread{margin-left:8rpx;padding:5rpx 10rpx;border-radius:999rpx;background:#d92d20;color:#fff!important;font-size:20rpx}.detail-link{margin-top:22rpx;text-align:right;color:#176b87;font-size:24rpx}.empty{text-align:center;color:#98a2b3;padding:90rpx 20rpx}
