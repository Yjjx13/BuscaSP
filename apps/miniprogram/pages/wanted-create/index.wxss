.hint{color:#667085;font-size:25rpx;line-height:1.65}.label{font-weight:600;margin:28rpx 0 14rpx}.photos{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.photo,.add{width:100%;aspect-ratio:1;border-radius:12rpx;overflow:hidden;background:#edf3f5}.photo image{width:100%;height:100%}.add{display:flex;align-items:center;justify-content:center;color:#176b87;font-size:55rpx;border:2rpx dashed #b8d4dc}textarea,input{display:block;background:#f6f8fa;border:2rpx solid transparent;border-radius:12rpx;padding:20rpx 22rpx;margin-bottom:18rpx}textarea:focus,input:focus{border-color:#4f96aa;background:#fff}.submit{width:100%;margin-top:34rpx;margin-bottom:calc(8rpx + env(safe-area-inset-bottom))}@media (max-width:350px){.photos{grid-template-columns:repeat(3,1fr)}}
