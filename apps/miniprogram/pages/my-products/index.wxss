.search-row{display:flex;gap:14rpx;margin-bottom:20rpx}.search-row input{min-width:0;flex:1;margin:0;background:#fff;border:2rpx solid #e5eaed;border-radius:12rpx;padding:18rpx 20rpx;font-size:27rpx}.search-row button{width:130rpx;margin:0}.loading,.empty{text-align:center;padding:70rpx 20rpx;color:#98a2b3}.product-card{display:flex;gap:18rpx;margin-bottom:18rpx;padding:18rpx}.product-card image{width:180rpx;height:180rpx;flex:0 0 180rpx;border-radius:12rpx;background:#eef2f4}.product-main{min-width:0;flex:1}.product-title{font-size:29rpx;line-height:1.45;word-break:break-all}.product-price{margin:10rpx 0;color:#c24156;font-size:31rpx;font-weight:600}.product-meta{color:#667085;font-size:23rpx;line-height:1.45}.actions{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.actions button{margin:0;line-height:1.8;font-size:23rpx}.actions .danger{color:#c24156;border-color:#f0c8d0}.product-main input{display:block;width:100%;box-sizing:border-box;margin-bottom:12rpx;padding:15rpx 16rpx;border:2rpx solid #d9e2e7;border-radius:10rpx;background:#fff;font-size:25rpx}@media(max-width:350px){.product-card{gap:12rpx}.product-card image{width:145rpx;height:145rpx;flex-basis:145rpx}}
