.search-box{position:relative;z-index:2}.input{display:block;background:#fff;border:2rpx solid transparent;border-radius:14rpx;padding:20rpx 24rpx;margin-bottom:16rpx}.input:focus{border-color:#4f96aa}.suggestion-panel{position:absolute;top:84rpx;left:0;right:0;overflow:hidden;background:#fff;border-radius:12rpx;box-shadow:0 8rpx 28rpx rgba(23,50,77,.14)}.suggestion-item{padding:22rpx 24rpx;border-bottom:1rpx solid #edf1f3;font-size:27rpx}.suggestion-item:last-child{border-bottom:0}.category-filter{margin:-4rpx 0 16rpx;color:#176b87;font-size:25rpx}.search-button{width:100%;margin-bottom:24rpx}.history{padding:4rpx 4rpx 18rpx}.history-head{display:flex;justify-content:space-between;align-items:center;font-size:28rpx;font-weight:600;margin:10rpx 0 18rpx}.history-head text:last-child{color:#667085;font-size:25rpx;font-weight:400}.history-tags{display:flex;flex-wrap:wrap;gap:14rpx}.history-tag{max-width:100%;padding:14rpx 20rpx;border-radius:30rpx;background:#fff;color:#48576a;font-size:25rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.result-title{font-size:34rpx;font-weight:600;margin:28rpx 0 16rpx}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;align-items:start}.product{min-width:0;overflow:hidden;background:#fff;border-radius:18rpx;box-shadow:0 4rpx 16rpx rgba(23,50,77,.06)}.product image{display:block;width:100%;min-height:240rpx;background:#eef2f4}.product-body{padding:18rpx}.desc{font-size:28rpx;line-height:1.45;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-all}.spec{margin-top:10rpx;color:#667085;font-size:23rpx;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.price{color:#c24156;font-size:32rpx;font-weight:600;margin:12rpx 0 6rpx;word-break:break-all}.seller{color:#98a2b3;font-size:22rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}@media (max-width:350px){.product-grid{gap:12rpx}.product-body{padding:14rpx}}
