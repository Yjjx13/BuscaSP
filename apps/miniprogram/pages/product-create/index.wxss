.label{font-weight:600;margin:28rpx 0 14rpx}.label:first-child{margin-top:0}.label text{color:#c24156;font-size:23rpx}.photos{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.photo,.add{width:100%;aspect-ratio:1;border-radius:12rpx;overflow:hidden;background:#edf3f5}.photo image{width:100%;height:100%}.add{display:flex;align-items:center;justify-content:center;color:#176b87;font-size:55rpx;border:2rpx dashed #b8d4dc}textarea,input{display:block;box-sizing:border-box;width:100%;margin-bottom:18rpx;padding:20rpx 22rpx;border:2rpx solid transparent;border-radius:12rpx;background:#f6f8fa}textarea:focus,input:focus{border-color:#4f96aa;background:#fff}.category-picker{display:flex;align-items:center;justify-content:space-between;padding:20rpx 22rpx;border-radius:12rpx;background:#f6f8fa;color:#667085}.category-picker text{font-size:38rpx}.price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}.price-grid text{display:block;min-height:54rpx;color:#667085;font-size:22rpx}.price-grid input{min-width:0}.submit{width:100%;margin-top:28rpx}@media(max-width:350px){.price-grid{grid-template-columns:1fr}.photos{grid-template-columns:repeat(3,1fr)}}
