.publish-page{min-height:100vh;margin:-28rpx -24rpx;background:#eef4f6}.publish-intro{padding:86rpx 52rpx 0}.publish-title{color:#173b4e;font-size:48rpx;font-weight:700}.publish-subtitle{margin-top:16rpx;color:#71808a;font-size:27rpx}.sheet-mask{position:fixed;inset:0;background:linear-gradient(180deg,rgba(39,90,110,.05),rgba(26,59,74,.25));pointer-events:none}.publish-sheet{position:fixed;right:0;bottom:0;left:0;z-index:1;min-height:55vh;padding:20rpx 30rpx calc(38rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:32rpx 32rpx 0 0;background:#fff;transform:translateY(100%);transition:transform .32s ease}.publish-sheet.open{transform:translateY(0)}.sheet-handle{width:76rpx;height:8rpx;margin:0 auto 28rpx;border-radius:8rpx;background:#d8e1e5}.sheet-title{margin:0 10rpx 26rpx;color:#243b4a;font-size:33rpx;font-weight:700}.publish-choice{display:flex;align-items:center;gap:20rpx;margin:18rpx 0;padding:28rpx 24rpx;border-radius:20rpx}.goods-choice{background:#e9f7f7}.wanted-choice{background:#f0f7fc}.choice-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:18rpx;background:#fff;color:#176b87;font-size:45rpx;font-weight:500}.choice-copy{min-width:0;flex:1;color:#24485a;font-size:31rpx;font-weight:600}.choice-copy text{display:block;margin-top:10rpx;color:#71808a;font-size:23rpx;font-weight:400}.choice-arrow{color:#77939f;font-size:45rpx}
