.category-page{display:flex;height:calc(100vh - env(safe-area-inset-bottom));background:#fff}.top-list{width:210rpx;flex:0 0 210rpx;background:#f5f8fa}.top-item{min-height:96rpx;display:flex;align-items:center;padding:0 20rpx;font-size:25rpx;line-height:1.35}.top-item.active{background:#fff;color:#176b87;font-weight:600;border-left:6rpx solid #176b87;padding-left:14rpx}.detail-list{flex:1;min-width:0;padding:28rpx 24rpx}.category-title{font-size:34rpx;font-weight:600;margin-bottom:24rpx}.second-block{margin-bottom:34rpx}.second-name{font-size:28rpx;font-weight:600;margin-bottom:16rpx}.third-list{display:flex;flex-wrap:wrap;gap:14rpx}.third-item{max-width:100%;padding:14rpx 18rpx;background:#f5f8fa;border-radius:10rpx;font-size:24rpx;color:#48576a}.drawer-layer{position:fixed;z-index:20;inset:0}.drawer-mask{position:absolute;inset:0;background:rgba(15,34,50,.34)}.category-drawer{position:absolute;top:0;right:0;bottom:0;width:92%;background:#f5f8fa;transform:translateX(100%);transition:transform .25s ease;display:flex;flex-direction:column;box-shadow:-10rpx 0 30rpx rgba(12,35,52,.14)}.category-drawer.open{transform:translateX(0)}.drawer-header{height:104rpx;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 24rpx;background:#fff;border-bottom:1rpx solid #e7edf1}.back-button{font-size:28rpx;color:#176b87;min-width:120rpx}.drawer-title{max-width:360rpx;font-size:31rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center}.header-space{min-width:120rpx}.drawer-search{display:flex;gap:14rpx;align-items:center;padding:20rpx 24rpx;background:#fff}.drawer-search input{flex:1;min-width:0;background:#f3f6f8;border-radius:12rpx;padding:18rpx 20rpx;font-size:26rpx}.search-action{padding:18rpx 22rpx;background:#176b87;color:#fff;border-radius:12rpx;font-size:26rpx}.product-scroll{flex:1;min-height:0;padding:20rpx 24rpx}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.product{overflow:hidden;background:#fff;border-radius:14rpx}.product image{width:100%;height:220rpx;background:#edf2f4}.product-body{padding:14rpx}.product-name{font-size:25rpx;line-height:1.42;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.product-spec{margin-top:8rpx;color:#7c8995;font-size:22rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.product-price{margin-top:10rpx;color:#c24156;font-weight:600;font-size:28rpx}.state-text{padding:90rpx 20rpx;text-align:center;color:#8794a0;font-size:26rpx}
