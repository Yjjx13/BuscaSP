.category-page{display:flex;height:calc(100vh - env(safe-area-inset-bottom));background:#fff}.top-list{width:210rpx;flex:0 0 210rpx;background:#f5f8fa}.top-item{min-height:96rpx;display:flex;align-items:center;padding:0 20rpx;font-size:25rpx;line-height:1.35}.top-item.active{background:#fff;color:#176b87;font-weight:600;border-left:6rpx solid #176b87;padding-left:14rpx}.detail-list{flex:1;min-width:0;padding:28rpx 24rpx}.category-title{font-size:34rpx;font-weight:600;margin-bottom:24rpx}.second-block{margin-bottom:34rpx}.second-name{font-size:28rpx;font-weight:600;margin-bottom:16rpx}.third-list{display:flex;flex-wrap:wrap;gap:14rpx}.third-item{max-width:100%;padding:14rpx 18rpx;background:#f5f8fa;border-radius:10rpx;font-size:24rpx;color:#48576a}
